# Copiar este archivo como .env y completar los valores. El .env NUNCA se sube al repositorio.

# Proveedor del modelo: anthropic | openai | simulado
LLM_PROVIDER=
# Modelo, por ejemplo claude-haiku-5-5 o claude-sonnet-5-5
LLM_MODEL=
# Clave de la API de Anthropic (Console de Anthropic > API Keys)
ANTHROPIC_API_KEY=
# Solo si LLM_PROVIDER=openai
OPENAI_API_KEY=
# Techo de tokens de salida por llamada
LLM_MAX_TOKENS=
# Solo OpenAI: Claude ya no acepta temperatura desde la API 2026-10-21
LLM_TEMPERATURE=
# Solo si LLM_PROVIDER=simulado: valido | invalido | invalido_luego_valido | sin_conexion | limite_uso
SIMULADO_ESCENARIO=
